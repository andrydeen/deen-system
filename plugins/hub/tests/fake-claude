#!/usr/bin/env python3
"""Stub for `claude -p --output-format stream-json`, used by hub tests."""
import json, os, re, signal, sys, time

argv = sys.argv[1:]
log = os.environ.get("FAKE_CLAUDE_LOG")
if log:
    with open(log, "a") as f:
        f.write(json.dumps({"argv": argv, "cwd": os.getcwd()}) + "\n")

def opt(name):
    return argv[argv.index(name) + 1] if name in argv and argv.index(name) + 1 < len(argv) else None

state = os.environ.get("FAKE_CLAUDE_STATE")
sid, rid = opt("--session-id"), opt("--resume")
if rid is not None and not (state and os.path.exists(os.path.join(state, rid))):
    sys.stderr.write("No conversation found with session ID: %s\n" % rid)
    sys.exit(1)
if sid and state:
    os.makedirs(state, exist_ok=True)
    open(os.path.join(state, sid), "a").close()

def emit(obj):
    sys.stdout.write((obj if isinstance(obj, str) else json.dumps(obj)) + "\n")
    sys.stdout.flush()

def on_int(signum, frame):
    emit({"type": "assistant", "message": {"content": [{"type": "text", "text": "partial..."}]}})
    emit({"type": "result", "subtype": "error_during_execution", "result": None,
          "errors": ["interrupted"], "total_cost_usd": 0.1})
    sys.exit(0)
signal.signal(signal.SIGINT, on_int)

DEFAULT = "Done.\n\nStatus: ready\nEval: n/a\nFiles: none\nNote: none"
RESULT_RE = re.compile(r'"type"\s*:\s*"result"')
delay = float(os.environ.get("FAKE_CLAUDE_SLEEP", "0") or 0)
slept = False

def pause():
    global slept
    if not slept:
        slept = True
        end = time.time() + delay
        while time.time() < end:
            time.sleep(0.05)

emit({"type": "system", "subtype": "init"})
events = os.environ.get("FAKE_CLAUDE_EVENTS")
has_result = False
if events:
    for line in open(events).read().splitlines():
        if not line.strip():
            continue
        if RESULT_RE.search(line):
            pause()
            has_result = True
        emit(line)
else:
    emit({"type": "assistant", "message": {"content": [{"type": "tool_use", "name": "Write",
          "input": {"file_path": os.path.join(os.getcwd(), "out.txt"), "content": "x"}}]}})
if not has_result:
    pause()
    emit({"type": "result", "result": os.environ.get("FAKE_CLAUDE_RESULT", DEFAULT),
          "total_cost_usd": 0.42})
sys.exit(int(os.environ.get("FAKE_CLAUDE_EXIT", "0") or 0))
